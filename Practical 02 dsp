# Practical 2: Operators
a = 10
b = 3

print("Arithmetic: a+b=", a+b, " a-b=", a-b, " a*b=", a*b, " a/b=", a/b)
print("Relational: a>b:", a>b, " a==b:", a==b)
print("Logical: (a>5 and b<5):", (a>5 and b<5), " not:", not(a>b))
print("Bitwise: a&b=", a & b, " a|b=", a | b)

x = 10
x += 5  # Assignment
print("Assignment (x+=5):", x)
